{
  "name": "canarycry-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-content.ts && react-router dev",
    "build": "node scripts/prepare-content.ts && react-router build && node scripts/assemble-dist.ts && vp test --project dist",
    "gate": "react-router typegen && vp check && vp test --project unit && pnpm run build",
    "preview": "node scripts/serve-dist.ts",
    "feed:refresh": "node scripts/prepare-content.ts --refresh",
    "extract-ghost": "node scripts/extract-ghost.ts",
    "fmt": "vp fmt"
  },
  "dependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jost": "5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/source-serif-4": "5.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "isbot": "5.2.2",
    "react": "19.2.9",
    "react-aria-components": "1.22.1",
    "react-dom": "19.2.9",
    "react-router": "8.4.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@react-router/dev": "8.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/sanitize-html": "2.16.2",
    "fast-xml-parser": "5.11.2",
    "sanitize-html": "2.18.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
    }
  }
}
